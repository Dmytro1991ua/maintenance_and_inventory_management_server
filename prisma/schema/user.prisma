enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        String     @id @default(uuid())
  userName  String     @unique
  email     String     @unique
  password  String
  roles     Role[]     @default([TECHNICIAN])
  status    UserStatus @default(ACTIVE)
  avatarUrl               String?
  notificationPreferences Json       @default("{}")
  // Labor cost per hour; managers set it. Not part of the normal user response.
  hourlyRate              Decimal?   @db.Decimal(10, 2)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  tasks                  Task[]
  recurringTasksAssigned RecurringTask[] @relation("RecurringTaskAssignee")
  recurringTasksCreated  RecurringTask[] @relation("RecurringTaskCreator")
  notifications          Notification[]
  taskComments           TaskComment[]   @relation("TaskCommentAuthor")
  workOrderRequests      WorkOrderRequest[] @relation("WorkOrderRequester")
  workOrderReviews       WorkOrderRequest[] @relation("WorkOrderReviewer")
  meterReadings          MeterReading[]  @relation("MeterReadingRecorder")
  timeEntries            TaskTimeEntry[] @relation("TimeEntryWorker")

  @@map("users")
}
