enum ChangeLogAction {
  CREATE
  UPDATE
  DELETE
}

enum ChangeLogEntity {
  ASSET
  ASSET_DOWNTIME
  TASK
  TASK_TIME_ENTRY
  RECURRING_TASK
  USER
  INVENTORY_ITEM
}

// One row per saved change, written in the same transaction.
model ChangeLog {
  id          String           @id @default(uuid())
  // Null for cron jobs, or once the user is deleted.
  userId      String?
  // User's name when changed; outlives the account.
  actorLabel  String?
  action      ChangeLogAction
  entityType  ChangeLogEntity
  // No foreign key: history outlives the entity.
  entityId    String
  // Name when changed.
  entityLabel String?
  // [{ field, oldValue, newValue }], allow-listed fields only.
  changes     Json
  createdAt   DateTime         @default(now())
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("change_logs")
}
