enum ReorderStatus {
  PENDING // auto-raised by the daily job (or a manual raise), awaiting an order
  ORDERED // a manager has placed the order with the supplier
  RECEIVED // stock arrived — the item quantity has been incremented
  CANCELLED // abandoned; reopens the low-stock/reorder loop for the item
}

model Reorder {
  id              String        @id @default(uuid())
  inventoryItemId String
  // Cascades with the item: a reorder is meaningless without it.
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  status          ReorderStatus @default(PENDING)
  // Units to order, snapshotted at raise so later config changes don't rewrite history.
  quantity        Int
  // The item's unit cost at raise (the estimate), frozen. Null if it was unpriced.
  unitCostAtRaise Decimal?      @db.Decimal(12, 2)
  // Actual unit price paid, optional at receive. Kept apart from the estimate.
  receivedUnitCost Decimal?     @db.Decimal(12, 2)
  // When it was received (null until then); spend is reported by this.
  receivedAt      DateTime?
  // Supplier and category frozen at receive, so item edits don't move past spend.
  receivedSupplier String?
  receivedCategory InventoryCategory?
  // Audit only (no FK). Null raisedBy = system/cron.
  raisedBy        String?
  reviewedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([inventoryItemId])
  @@index([status, createdAt])
  @@map("reorders")
}
